# Tap container — required environment variables
# Set in Railway dashboard for production (never commit real values)

# Required
TAP_ADMIN_PASSWORD=change-me-strong-random-password

# Defaults (already set in Dockerfile — override if needed)
# TAP_RELAY_HOST=wss://bsky.network
# TAP_LOG_LEVEL=info
# TAP_RETRY_TIMEOUT=60s

# DO NOT set TAP_FULL_NETWORK=true — would consume terabytes of data
