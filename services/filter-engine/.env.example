# Filter Engine — required environment variables
# Copy to .env for local development; set in Railway dashboard for production.

# ── Tap connection ────────────────────────────────────────────────────────────
# In Railway: use the private network hostname of the Tap service
TAP_URL=http://tap.railway.internal:2480
TAP_ADMIN_PASSWORD=change-me-strong-random-password

# ── Amazon OpenSearch Service ─────────────────────────────────────────────────
# The percolator index (ff_feed_queries) must exist before starting.
# Run POST /internal/percolator/sync on the CF Worker to bootstrap it.
OPENSEARCH_URL=https://your-cluster.us-east-1.es.amazonaws.com
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-me-opensearch-master-password

# ── CF Worker write endpoint ──────────────────────────────────────────────────
# Matched posts are written to D1 via the CF Worker's /internal/posts endpoint.
WRITE_ENDPOINT_URL=https://friendly-feed.jason-edelman.org/internal/posts
WRITE_ENDPOINT_SECRET=change-me-same-as-worker-internal-secret

# ── No longer needed (removed in percolator migration) ───────────────────────
# CONFIG_ENDPOINT_URL      (feed configs are now stored in the percolator index)
# CONFIG_ENDPOINT_SECRET   (same)
